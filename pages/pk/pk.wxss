.page { padding: 24rpx; box-sizing: border-box; min-height: 100vh; background: #f6f7fb; }

.rank-bar { padding: 16rpx 24rpx; background: #4f6cff; color: #fff; display: flex; align-items: center; gap: 20rpx; font-size: 28rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.rb-tier { font-size: 32rpx; font-weight: 600; }
.rb-score, .rb-rank { font-size: 26rpx; opacity: 0.9; }

.section-title { font-size: 28rpx; color: #666; margin: 24rpx 0 12rpx; }
.primary-btn { width: 100% !important; margin-bottom: 16rpx; }
.ghost-btn { background: transparent; color: #4f6cff; border: 1rpx solid #4f6cff; font-size: 26rpx; }
.lobby-empty { text-align: center; color: #999; padding: 40rpx 0; font-size: 26rpx; }
.lobby-item { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 12rpx; display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; }
.li-name { flex: 1; color: #333; }
.li-tier { color: #4f6cff; font-weight: 600; }
.li-time { color: #999; font-size: 22rpx; }

.big-tip { text-align: center; font-size: 36rpx; color: #4f6cff; padding: 80rpx 0 24rpx; }
.hint { text-align: center; color: #999; font-size: 26rpx; margin-bottom: 32rpx; }

.match-header { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; font-size: 30rpx; color: #4f6cff; font-weight: 600; }
.timer { color: #999; font-size: 32rpx; font-weight: 700; }
.timer.warning { color: #f56c6c; }
.score-row { display: flex; justify-content: space-around; align-items: center; padding: 16rpx 24rpx; background: #fff; border-radius: 12rpx; margin-bottom: 16rpx; font-size: 30rpx; font-weight: 600; }
.vs { color: #999; font-size: 24rpx; }

.progress { color: #999; font-size: 26rpx; margin-bottom: 8rpx; }
.question-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.q-content { font-size: 32rpx; line-height: 1.6; color: #333; margin-bottom: 24rpx; }
.options { display: flex; flex-direction: column; gap: 16rpx; }
.option { padding: 20rpx 24rpx; background: #f5f5f7; border-radius: 12rpx; font-size: 28rpx; color: #333; border: 2rpx solid transparent; }
.option.selected { background: #eaf0ff; color: #4f6cff; border-color: #4f6cff; }
.nav-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.nav-btn { flex: 1; }

.result-card { background: #fff; border-radius: 16rpx; padding: 64rpx 32rpx; text-align: center; margin-bottom: 24rpx; }
.rs-title { font-size: 56rpx; font-weight: 700; color: #4f6cff; }
.rs-score { font-size: 36rpx; color: #333; margin: 16rpx 0; }
.rs-delta { font-size: 28rpx; color: #67c23a; }

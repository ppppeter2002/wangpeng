.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4f46e5 0%, #7c3aed 100%);
}
.logo { font-size: 120rpx; margin-bottom: 20rpx; }
.title { font-size: 48rpx; font-weight: bold; color: #fff; }
.subtitle { font-size: 28rpx; color: rgba(255,255,255,0.8); margin-top: 10rpx; }
.role-select {
  display: flex;
  gap: 20rpx;
  margin-top: 80rpx;
  margin-bottom: 60rpx;
}
.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.role-item.active {
  background: #fff;
  color: #4f46e5;
  border-color: #fbbf24;
}
.role-emoji { font-size: 48rpx; margin-bottom: 10rpx; }
.login-btn {
  width: 100%;
  background: #fbbf24;
  color: #1f2937;
  font-weight: bold;
  border-radius: 50rpx;
  font-size: 32rpx;
}
.tip { margin-top: 30rpx; font-size: 24rpx; color: rgba(255,255,255,0.6); }

.chat-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.chat-panel {
  width: 100%;
  height: 80vh;
  background: #f5f5f7;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #4f46e5;
  color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  font-size: 30rpx;
}
.close { font-size: 36rpx; }
.chat-body { flex: 1; padding: 20rpx; overflow-y: auto; }
.msg { margin-bottom: 20rpx; display: flex; }
.msg.user { justify-content: flex-end; }
.bubble {
  max-width: 70%;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}
.msg.user .bubble { background: #4f46e5; color: #fff; }
.msg.ai .bubble { background: #fff; color: #333; }
.chat-input {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.input {
  flex: 1;
  background: #f0f0f0;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 70rpx;
  font-size: 28rpx;
}
.send-btn {
  background: #4f46e5;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 30rpx;
}

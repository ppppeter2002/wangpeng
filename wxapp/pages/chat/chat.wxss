.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f7fb;
  box-sizing: border-box;
}

.rank-bar {
  padding: 16rpx 24rpx;
  background: #4f6cff;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
}
.rank-bar.empty { background: #b0b0b0; }
.rb-tier { font-size: 32rpx; font-weight: 600; }
.rb-score, .rb-rank { font-size: 26rpx; opacity: 0.9; }

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.placeholder {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 200rpx;
}

.bubble-wrap { display: flex; margin: 16rpx 0; }
.bubble-wrap.me { justify-content: flex-end; }
.bubble-wrap.ai { justify-content: flex-start; }

.bubble {
  max-width: 76%;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}
.bubble-me { background: #4f6cff; color: #fff; border-bottom-right-radius: 4rpx; }
.bubble-ai { background: #fff; color: #333; border: 1rpx solid #eee; border-bottom-left-radius: 4rpx; }
.bubble.typing { color: #999; font-style: italic; }

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}
.send-btn { margin-left: 16rpx; }

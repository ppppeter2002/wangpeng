.page { padding: 16rpx; background: #f5f5f7; min-height: 100vh; }
.header { padding: 16rpx 8rpx; margin-bottom: 16rpx; }
.header .title { font-size: 36rpx; font-weight: 600; color: #1f2937; }
.header .sub { font-size: 26rpx; color: #6b7280; margin-top: 8rpx; }

.form { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.form-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.label { width: 120rpx; font-size: 28rpx; color: #4b5563; }
.picker { flex: 1; font-size: 28rpx; color: #1f2937; }
.input { flex: 1; font-size: 28rpx; color: #1f2937; }

.textarea-wrap { margin: 16rpx 0; position: relative; }
.textarea { width: 100%; min-height: 300rpx; padding: 16rpx; background: #f9fafb; border-radius: 12rpx; font-size: 28rpx; line-height: 1.6; box-sizing: border-box; }
.char-count { position: absolute; right: 16rpx; bottom: 16rpx; font-size: 22rpx; color: #9ca3af; }

.upload-row { margin: 16rpx 0; }
.upload-btn { background: #f3f4f6; color: #4f46e5; font-size: 26rpx; }

.submit-btn { background: #4f46e5; color: #fff; font-size: 30rpx; margin-top: 16rpx; }
.submit-btn.disabled { background: #9ca3af; }

.result-card { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; border-left: 8rpx solid #10b981; }
.result-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 16rpx; }
.result-row { font-size: 28rpx; color: #4b5563; margin: 8rpx 0; }
.num { font-weight: 600; color: #4f46e5; }
.goto-list { margin-top: 24rpx; background: #eef2ff; color: #4f46e5; font-size: 28rpx; }

.page { padding: 24rpx; box-sizing: border-box; min-height: 100vh; background: #f6f7fb; }

/* idle */
.rank-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.rc-tier { font-size: 56rpx; font-weight: 700; color: #4f6cff; }
.rc-row { color: #666; font-size: 28rpx; margin-top: 8rpx; }
.rc-weak { color: #e6a23c; font-size: 26rpx; margin-top: 8rpx; }
.empty-tip { text-align: center; color: #999; padding: 40rpx 0; }
.primary-btn { margin-top: 24rpx; width: 100% !important; }

/* testing */
.test-header { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 8rpx; color: #4f6cff; font-size: 28rpx; font-weight: 600; }
.progress { color: #999; font-weight: 400; }
.question-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.q-title { color: #999; font-size: 26rpx; margin-bottom: 8rpx; }
.q-content { font-size: 32rpx; line-height: 1.6; color: #333; margin-bottom: 24rpx; }
.options { display: flex; flex-direction: column; gap: 16rpx; }
.option { padding: 20rpx 24rpx; background: #f5f5f7; border-radius: 12rpx; font-size: 28rpx; color: #333; border: 2rpx solid transparent; }
.option.selected { background: #eaf0ff; color: #4f6cff; border-color: #4f6cff; }
.options.free-text .option { color: #666; }
.nav-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.nav-btn { flex: 1; }

/* result */
.result-card { background: #fff; border-radius: 16rpx; padding: 48rpx 32rpx; text-align: center; margin-bottom: 24rpx; }
.rs-score { font-size: 80rpx; font-weight: 700; color: #4f6cff; }
.rs-detail { color: #666; font-size: 28rpx; margin: 8rpx 0 24rpx; }
.rs-status { font-size: 40rpx; font-weight: 600; }
.rs-status.passed { color: #67c23a; }
.rs-status.failed { color: #f56c6c; }
.rs-up { margin-top: 24rpx; color: #4f6cff; font-size: 28rpx; }
.rs-up.failed-tip { color: #999; }

<view class="page">
  <view class="header">
    <view class="hello">通知中心</view>
    <view class="sub">点击单条可标记已读，或全部已读</view>
  </view>

  <view class="btn btn-ghost" bindtap="markAllRead">全部标记已读</view>

  <view class="card">
    <view class="card-item" wx:for="{{notifications}}" wx:key="id" data-id="{{item.id}}" bindtap="markRead">
      <view class="row">
        <text class="title">{{item.title}}</text>
        <text class="tag {{item.read ? '' : 'tag-warn'}}">{{item.read ? '已读' : '未读'}}</text>
      </view>
      <view class="muted">{{item.content}}</view>
      <view class="muted">{{item.type}} · {{item.createdAt}}</view>
    </view>
    <view class="empty-tip" wx:if="{{notifications.length === 0 && !loading}}">暂无通知</view>
  </view>
</view>

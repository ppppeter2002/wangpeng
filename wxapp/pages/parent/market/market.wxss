.page { padding: 24rpx; min-height: 100vh; box-sizing: border-box; background: #f5f5f7; }
.header { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; padding: 32rpx 24rpx; border-radius: 16rpx; margin-bottom: 24rpx; }
.hello { font-size: 36rpx; font-weight: 600; }
.sub { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.wallet-card { background: linear-gradient(135deg, #eef2ff, #ffffff); }
.card-item { padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.card-item:last-child { border-bottom: none; }
.empty-tip { color: #999; text-align: center; padding: 40rpx 0; }
.btn { background: #4f46e5; color: #fff; border-radius: 12rpx; padding: 18rpx 0; text-align: center; font-size: 28rpx; margin-top: 16rpx; }
.btn-ghost { background: #fff; color: #4f46e5; border: 2rpx solid #4f46e5; }
.btn-inline { margin-top: 0; padding: 16rpx 24rpx; min-width: 200rpx; }
.btn-danger { background: #ef4444; color: #fff; }
input.text, textarea.area { background: #f7f7f9; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.wallet-row { gap: 20rpx; }
.wallet-balance { font-size: 48rpx; font-weight: 700; color: #312e81; }
.tag { display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx; background: #e0e7ff; color: #4f46e5; font-size: 22rpx; margin-right: 8rpx; }
.tag-warn { background: #fef3c7; color: #b45309; }
.label { color: #999; font-size: 24rpx; margin-bottom: 8rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.subtitle { font-size: 26rpx; color: #666; }
.pill { display: inline-block; padding: 6rpx 18rpx; border-radius: 999rpx; background: #e0e7ff; color: #4f46e5; font-size: 24rpx; }
.muted { color: #888; font-size: 24rpx; }
.divider { height: 1rpx; background: #eee; margin: 16rpx 0; }

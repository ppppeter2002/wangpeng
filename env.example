# smart-tutor 环境变量模板（复制为 .env 后填入真实值；本文件不提交真实值）
# T-022-prep：所有值走进程环境变量，不碰 .env

# 腾讯混元 / OpenAI 兼容代理（T-018 引入）
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hotrouter.ai/v1
HUNYUAN_MODEL=hy3
HUNYUAN_MAX_TOKENS=4000

# 微信小程序（T-020a 引入）
WX_APPID=
WX_SECRET=

# 微信服务号 / 公众号模板消息（T-019-prep 引入）
WX_SERVICE_APPID=
WX_SERVICE_SECRET=
WX_SERVICE_TOKEN=
WX_SERVICE_AES_KEY=

# 服务端口（T-022-prep 引入，默认 3000）
PORT=3000
